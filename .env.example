# OpenAI-compatible endpoint serving iapp/openthai2.0-qwen3.8-27b (must include /v1)
#   vLLM:      http://localhost:8000/v1
#   Ollama:    http://localhost:11434/v1
#   llama.cpp: http://localhost:8080/v1
OPENTHAI_BASE_URL=http://localhost:8000/v1

# Model name as the server knows it (vLLM: the HF id or --served-model-name; Ollama: the tag you pulled)
OPENTHAI_MODEL=iapp/openthai2.0-qwen3.8-27b

# Bearer token if the server requires one (vLLM --api-key, hosted endpoints). Leave empty otherwise.
OPENTHAI_API_KEY=

# Structured output: json_schema (vLLM/SGLang/llama.cpp/Ollama recent) | json_object | none
OPENTHAI_JSON_MODE=json_schema

# Send chat_template_kwargs.enable_thinking=false (Qwen3-family). Set to false if your server rejects it.
OPENTHAI_DISABLE_THINKING=true

OPENTHAI_TIMEOUT_MS=120000
OPENTHAI_MAX_TOKENS=4096
